# Copy to db-secret.yaml and fill in your RDS credentials
# kubectl apply -f db-secret.yaml
# 
# For in-memory mode (no persistence), you can skip this - the app will work without DB vars.

apiVersion: v1
kind: Secret
metadata:
  name: writing-analyzer-db
  namespace: writing-analyzer
type: Opaque
stringData:
  host: "your-rds-endpoint.region.rds.amazonaws.com"
  port: "5432"
  name: "writing_analyzer"
  user: "your_db_user"
  password: "your_db_password"
  ssl: "true"
